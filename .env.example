# Copy to .env (scripts/start-all.sh does it for you and generates a secret).
CAMPUSOS_SECRET=change-me
CAMPUSOS_TOKEN_TTL_SECONDS=28800
CAMPUSOS_DATA_DIR=data
CAMPUSOS_ALLOWED_ORIGIN=http://localhost:5173
SDU_BAGDAR_SKIP_VERIFICATION=false
SDU_BAGDAR_SKIP_TEACHER_INVITE=true

GATEWAY_PORT=8080
CAMPUSPLUS_PORT=8081
FIXMYCAMPUS_PORT=8082
PROJECTFORGE_PORT=8083
AI_VALIDATION_PORT=8084

CAMPUSPLUS_URL=http://localhost:8081/api/v1
FIXMYCAMPUS_URL=http://localhost:8082/api/v1
PROJECTFORGE_URL=http://localhost:8083/api/v1
AI_VALIDATION_URL=http://localhost:8084
MAILER_PORT=8085
MAILER_URL=http://localhost:8085/api/v1
# Optional external AI provider URL. The local validator works when this is empty.
AI_PROVIDER_URL=

# Decorator chain for FixMyCampus report processing (order = outermost first)
FIXMYCAMPUS_PIPELINE=validation,duplicate,notification

# Demo accounts are created only when true
CAMPUSOS_SEED_DEMO=true
DEMO_STUDENT_PASSWORD=student123
DEMO_TEACHER_PASSWORD=teacher123
TEACHER_INVITE_CODE=sdu-teacher

# Verification codes: set SDU_BAGDAR_SKIP_VERIFICATION=false to require them.
# MAIL_DELIVERY=mailer sends real email through the Mailer service; "console" prints codes in build/logs/gateway.log.
MAIL_DELIVERY=mailer
# SMTP account used by the Mailer service. Use an app password, never your normal password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SDU Bağdar <no-reply@example.com>
